---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostsContent from '../../../../components/PostsContent.astro';
import { getAllTags } from '../../../../lib/posts';
import { useTranslations } from '../../../../lib/i18n';
import { tagPage, tagCardPath } from '../../../../lib/pages';

export async function getStaticPaths() {
  const tags = await getAllTags('pt');
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const t = useTranslations('pt');
const page = tagPage('pt', tag!);
---

<BaseLayout title={`${page.title} — ${t('site.name')}`} description={page.description} lang="pt" image={tagCardPath('pt', tag!)}>
  <PostsContent lang="pt" tag={tag} />
</BaseLayout>
