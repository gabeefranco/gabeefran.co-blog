---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostsContent from '../../components/PostsContent.astro';
import { useTranslations } from '../../lib/i18n';
import { PAGES, pageCardPath } from '../../lib/pages';

const t = useTranslations('en');
const page = PAGES.en.posts;
---

<BaseLayout title={`${page.title} — ${t('site.name')}`} description={page.description} lang="en" image={pageCardPath('en', 'posts')}>
  <PostsContent lang="en" />
</BaseLayout>
