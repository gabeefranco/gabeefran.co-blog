---
import { existsSync } from 'node:fs';
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { HREFLANGS, localizedAlternates, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /**
   * Path under public/ for the OG image, e.g. /social-cards/en/hello-world.png.
   * Cards are generated by scripts/generate-social-cards.ts; until one exists
   * on disk we fall back to the logo.
   */
  image?: string;
  /** Keep the page out of search engines (used for draft posts). */
  noindex?: boolean;
  /**
   * This page in each language it exists in, for hreflang links and the
   * language switcher. Defaults to the same path under every language; pages
   * whose URL differs per language (posts) or that may be missing in some
   * language (posts, tags) pass their own.
   */
  alternates?: Partial<Record<Lang, string>>;
}

const { title, description, lang, noindex, alternates = localizedAlternates(Astro.url.pathname) } = Astro.props;
const image = Astro.props.image && existsSync(`public${Astro.props.image}`) ? Astro.props.image : '/logo.png';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    {Object.entries(alternates).map(([altLang, path]) => (
      <link rel="alternate" hreflang={HREFLANGS[altLang as Lang]} href={new URL(path, Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href="https://gabeefran.co/" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gabriel Franco's notes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    {image.startsWith('/social-cards/') && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <Font cssVariable="--font-iawriter" preload />


    <script
      is:inline
      defer
      src="https://stats.gabeefran.co/gabest.js"
      data-website-id="d8448824-f620-48e0-98ab-c0ea596dc17d"
      data-domains="gabeefran.co"
    ></script>

    <script is:inline>
      // Runs before paint to avoid a flash of the wrong theme.
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const dark = stored ? stored === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-bg font-sans text-text antialiased selection:bg-primary selection:text-white">
    <Header lang={lang} alternates={alternates} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
